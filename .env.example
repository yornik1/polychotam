# --- Postgres ---
# обязательно. Хост postgres — для docker compose; для локального запуска заменить на localhost.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/polychotam

# --- Redis ---
# обязательно. Хост redis — для docker compose; для локального запуска заменить на localhost.
REDIS_URL=redis://redis:6379

# --- Telegram ---
# обязательно. Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=replace_me
# ID чата для admin-команд (/queues, /errors, /ws, /alerts) и служебных алертов.
ADMIN_CHAT_ID=replace_me

# --- Polymarket ---
# обязательно. WebSocket market channel CLOB. Не путать с wss://clob.polymarket.com/ws/market — тот отдаёт 404.
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# REST endpoint CLOB (заявки, маркеты).
POLYMARKET_REST_URL=https://clob.polymarket.com
# Data API (история сделок по маркету).
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
# Leaderboard API (profit по окнам 1d/7d/30d/all).
POLYMARKET_LB_API_URL=https://lb-api.polymarket.com
# Gamma API (топ-маркеты, метаданные). Используется cron-сервисом.
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
# Пауза между страницами при backfill истории — не долбим API.
POLYMARKET_BACKFILL_PAGE_DELAY_MS=1000
# Таймаут HTTP-запросов к Polymarket.
POLYMARKET_HTTP_TIMEOUT_MS=10000
# Путь маркетов в gamma-API (на случай миграции эндпоинта).
POLYMARKET_MARKETS_PATH=/markets
# Сколько топ-маркетов брать в WS подписку (по умолчанию 20). Больше = больше потока, но и нагрузки.
# Безопасный диапазон 20-50 для t3.small. Максимум 200.
POLYMARKET_TOP_MARKETS_LIMIT=20

# --- Logging ---
# NDJSON-лог ошибок BullMQ (событие failed по всем очередям). Пустое значение — отключить.
BULL_JOB_ERRORS_LOG_PATH=logs/bull-job-errors.ndjson

# --- Alerts ---
# Окно дедупликации TG-алертов (мс): один и тот же tradeTimestamp + кошелёк + маркет + сумма не отправится дважды.
ALERT_DEDUP_TTL_MS=180000

# --- PnL кросс-валидация (T6) ---
# Калибровочные значения по эмпирическим спайкам 2026-06-10; НЕ подгонять под зелёные тесты.
# Абсолютный порог прохода (в $): расхождение ≤ max(EPS_ABS, EPS_REL·|lb|) → pass.
WALLET_PNL_EPS_ABS=1
# Относительный порог прохода (доля от |lb|).
WALLET_PNL_EPS_REL=0.01
# Абсолютный порог «на доисследование» (в $): расхождение > max(INVESTIGATE_ABS, INVESTIGATE_REL·|lb|) → investigate.
WALLET_PNL_INVESTIGATE_ABS=50
# Относительный порог «на доисследование» (доля от |lb|).
WALLET_PNL_INVESTIGATE_REL=0.02

# --- Скоринг кошельков (T8) ---
# Минимальный win rate для попадания в /top из wallet_scores (граница включительно).
# НЕ менять вместе с minWinRate=0.6 из smart-wallets.service — это разные пайплайны.
SMART_TOP_MIN_WIN_RATE=0.55
